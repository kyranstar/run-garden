{
  "name": "run-garden",
  "private": true,
  "version": "0.1.0",
  "description": "Private running companion: COROS plan \u2192 realistic calendar \u2192 living garden",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "dev:web": "pnpm --filter @rg/web dev",
    "dev:worker": "pnpm --filter @rg/worker dev",
    "dev:desktop": "pnpm --filter @rg/desktop tauri dev",
    "dev": "pnpm --filter @rg/worker dev & pnpm --filter @rg/web dev",
    "build:web": "pnpm --filter @rg/web build",
    "build:worker": "pnpm --filter @rg/worker build",
    "db:generate": "pnpm --filter @rg/database generate",
    "db:migrate:local": "pnpm --filter @rg/worker db:migrate:local",
    "coros:census": "pnpm --filter @rg/coros-bridge census",
    "coros:spike": "pnpm --filter @rg/coros-bridge spike",
    "coros:spike:create": "pnpm --filter @rg/coros-bridge spike:create",
    "coros:spike:cleanup": "pnpm --filter @rg/coros-bridge spike:cleanup",
    "coros:spike:dryrun": "pnpm --filter @rg/coros-bridge spike:dryrun",
    "e2e": "pnpm --filter @rg/web e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
