# ─────────────────────────────────────────────────────────────────────────────
# Run Garden — environment reference
#
# This file documents EVERY secret and variable the system uses. It is a
# reference, not a loaded file: the worker reads secrets from Cloudflare
# (`wrangler secret put NAME`, run from apps/worker/) and non-secret vars from
# apps/worker/wrangler.toml [vars]. For local development, copy
# apps/worker/.dev.vars.example → apps/worker/.dev.vars instead.
#
# Legend:
#   [secret] → set with `wrangler secret put NAME` (never committed, never in wrangler.toml)
#   [var]    → set in apps/worker/wrangler.toml [vars] (non-secret configuration)
# ─────────────────────────────────────────────────────────────────────────────

# ── Core app secrets ─────────────────────────────────────────────────────────

# [secret] Random secret reserved for session hardening. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# [secret] AES-256-GCM key for encrypting Google/Strava OAuth tokens at rest
# in D1. MUST be exactly 32 bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# Losing/rotating this key invalidates stored provider tokens (reconnect to fix).
TOKEN_ENCRYPTION_KEY=

# [secret] The ONE Google account allowed to sign in. Run Garden is a
# single-user app: every other Google account is rejected at the OAuth
# callback. Set to your own Gmail address (case-insensitive match).
ALLOWED_GOOGLE_EMAIL=you@example.com

# ── Google OAuth (sign-in + Calendar) ────────────────────────────────────────
# Where to get them: https://console.cloud.google.com/
#   1. Create a project → "APIs & Services" → enable the Google Calendar API.
#   2. Configure the OAuth consent screen (External is fine; you are the only
#      user — add ALLOWED_GOOGLE_EMAIL as a test user, no verification needed).
#   3. Credentials → Create credentials → OAuth client ID → Web application.
#      Authorized redirect URI: {APP_URL}/api/auth/google/callback
#      (add http://localhost:8787/api/auth/google/callback for local dev).
# Scopes requested by the app: openid email profile, calendar.app.created,
# calendar.calendarlist.readonly, calendar.events, calendar.freebusy.

# [secret] OAuth 2.0 client ID from the Google Cloud console.
GOOGLE_CLIENT_ID=
# [secret] OAuth 2.0 client secret from the Google Cloud console.
GOOGLE_CLIENT_SECRET=

# ── Strava (optional, read-only) ─────────────────────────────────────────────
# Where to get them: https://www.strava.com/settings/api
#   Note: since 2026-06-01 Strava requires a paid Strava subscription
#   (~$12/mo) on the developer's account for API access. New apps start in
#   "single-player mode" (only your own account can authenticate) — exactly
#   what Run Garden needs; no app review required.
#   "Authorization Callback Domain" must match APP_URL's host; the app uses
#   redirect URI {APP_URL}/api/strava/callback and scope activity:read_all.

# [secret] Strava application client ID.
STRAVA_CLIENT_ID=
# [secret] Strava application client secret.
STRAVA_CLIENT_SECRET=
# [secret] Token you invent yourself; Strava echoes it back on webhook
# subscription validation (hub.verify_token). Generate with:
#   openssl rand -hex 16
STRAVA_WEBHOOK_VERIFY_TOKEN=

# ── Anthropic (optional, weekly-review narrative only) ───────────────────────
# Where to get it: https://console.anthropic.com/ → API keys.
# Used only server-side for the Monday weekly review (Haiku-class model,
# hard budget: warn $2 / auto-disable $8 / absolute max $10 per rolling 7 days).
# Leave unset to run fully without AI — the app stays completely functional.

# [secret] Anthropic API key (sk-ant-…).
ANTHROPIC_API_KEY=

# ── Official COROS MCP (optional cloud reads / capability probing) ───────────
# The official COROS MCP (https://mcp.coros.com/mcp) is read-only today; its
# write tools are announced "coming soon". When configured, the worker probes
# tools/list for capability changes. Auth is OAuth against your COROS account.

# [secret] MCP endpoint, e.g. https://mcp.coros.com/mcp
COROS_MCP_URL=
# [secret] Bearer token for the MCP connection.
COROS_MCP_TOKEN=

# ── Strava API base override ─────────────────────────────────────────────────
# [secret, optional] Defaults to https://www.strava.com/api/v3. Exists for the
# announced 2027-06-01 Strava migration to https://www.api-v3.strava.com —
# flip it here without a code change when the time comes.
STRAVA_API_BASE=

# ── Non-secret vars (apps/worker/wrangler.toml [vars]) ───────────────────────

# [var] Public URL of the deployed worker (no trailing slash). Drives OAuth
# redirect URIs, calendar deep links, and the CSRF origin check.
APP_URL=https://run-garden-api.YOUR_SUBDOMAIN.workers.dev

# [var] "1" = deterministic fixture data + /api/dev/fixture-login, no real
# providers needed. Use for local dev and demos; keep "0" in production.
FIXTURE_MODE=0

# [var] "0" disables all LLM calls globally regardless of user preference.
AI_DEFAULT_ENABLED=1
