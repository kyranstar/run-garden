{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Run Garden desktop capabilities",
  "windows": ["main", "ambient"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/coros-bridge", "sidecar": true }]
    }
  ]
}
