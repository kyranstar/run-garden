{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Run Garden",
  "version": "0.1.11",
  "identifier": "com.rungarden.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Run Garden",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:8787 https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png"],
    "category": "Healthcare and Fitness",
    "shortDescription": "Your COROS plan, fitted to your real week.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "externalBin": ["binaries/coros-bridge"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kyranstar/run-garden/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1RTU4OEYxOTY5Rjc5REMKUldUY2VaK1c4WWpsMVI1dE55ZHhaRFZSRXpPaURhcVBCTVJqUVVTYTFMU0RKRXA1RDBBM0d3UCsK"
    }
  }
}
